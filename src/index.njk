---
layout: layouts/base.njk
title: Kitchen, Bathroom & Home Remodeling
description: J-Dub Remodeling LLC handles kitchen, bathroom, and general home remodeling. Talk with Justin Robson about your project and get a free quote.
---
<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow eyebrow-dark">{{ site.name }}</p>
      <h1>Kitchen &amp; bathroom remodeling, handled by Justin.</h1>
      <p class="lede">Tell Justin what you want changed. He’ll talk it through with you and put together a free quote for the work.</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-lg" href="/contact/#quote">Request a Free Quote</a>
        <a class="btn btn-secondary btn-lg" href="tel:{{ site.contact.phoneE164 }}" data-track="phone">Call {{ site.contact.phoneDisplay }}</a>
      </div>
      <p class="hero-phone">Prefer to text? <a href="sms:{{ site.contact.phoneE164 }}" data-track="text">Message Justin at {{ site.contact.phoneDisplay }}</a></p>
    </div>
    <figure class="hero-art" aria-hidden="true">
      <img src="/assets/img/kitchen-elevation.svg" width="560" height="420" alt="">
    </figure>
  </div>
</section>

<section class="facts" aria-label="At a glance">
  <div class="container facts-inner">
    <p><strong>Kitchens</strong> Full remodels and focused updates</p>
    <p><strong>Bathrooms</strong> Main, guest, and half baths</p>
    <p><strong>General remodeling</strong> The rest of the house</p>
    <p><strong>Free quote</strong> Call, text, or send the form</p>
  </div>
</section>

<section class="section" aria-labelledby="services-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow-dark">What we do</p>
      <h2 id="services-heading">Remodeling that starts with how you use your home</h2>
    </div>
    <ol class="service-rows">
      <li>
        <a class="service-row" href="/services/#kitchens">
          <span class="service-num" aria-hidden="true">01</span>
          <div class="service-text">
            <h3>Kitchen remodeling</h3>
            <p>Rework a kitchen that no longer fits the way you cook, gather, and store things.</p>
          </div>
          <span class="card-link">Kitchens</span>
        </a>
      </li>
      <li>
        <a class="service-row" href="/services/#bathrooms">
          <span class="service-num" aria-hidden="true">02</span>
          <div class="service-text">
            <h3>Bathroom remodeling</h3>
            <p>Turn a dated or hard-to-use bathroom into one that works better every day.</p>
          </div>
          <span class="card-link">Bathrooms</span>
        </a>
      </li>
      <li>
        <a class="service-row" href="/services/#general">
          <span class="service-num" aria-hidden="true">03</span>
          <div class="service-text">
            <h3>General remodeling</h3>
            <p>Other rooms and projects around the house. If it’s on your list, ask about it.</p>
          </div>
          <span class="card-link">More</span>
        </a>
      </li>
    </ol>
  </div>
</section>

{%- if gallery.length %}
<section class="section section-alt" aria-labelledby="projects-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow-dark">Recent work</p>
      <h2 id="projects-heading">Before and after</h2>
    </div>
    <div class="project-grid">
      {%- asyncEach project in gallery | featured(3) %}
      {% include "partials/project-card.njk" %}
      {%- endeach %}
    </div>
    <p class="section-more"><a class="btn btn-secondary" href="/projects/">See all projects</a></p>
  </div>
</section>
{%- include "partials/lightbox.njk" %}
{%- endif %}

<section class="section{% if not gallery.length %} section-alt{% endif %}" aria-labelledby="process-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow-dark">Getting started</p>
      <h2 id="process-heading">Three steps to a quote</h2>
    </div>
    <ol class="steps">
      <li>
        <h3>Reach out</h3>
        <p>Call, text, or send the quote form with a short description of what you want done.</p>
      </li>
      <li>
        <h3>Talk it through</h3>
        <p>Justin follows up to learn about the space, what you’re hoping for, and your timing.</p>
      </li>
      <li>
        <h3>Get your free quote</h3>
        <p>You get a quote for the work you discussed, so you can decide on your next step.</p>
      </li>
    </ol>
  </div>
</section>

<section class="direct" aria-labelledby="about-heading">
  <div class="container direct-inner">
    <div>
      <p class="eyebrow">Your point of contact</p>
      <h2 id="about-heading">You’ll talk directly with {{ site.contact.person }}</h2>
      <p>When you contact {{ site.name }}, you reach Justin himself. Bring your ideas, your questions, and the parts of your home that need attention.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/contact/#quote">Request a Free Quote</a>
        <a class="btn btn-outline-light" href="/about/">About J-Dub Remodeling</a>
      </div>
    </div>
    <div class="contact-card">
      <p class="contact-card-name">{{ site.contact.person }}</p>
      <ul class="contact-list">
        <li><a href="tel:{{ site.contact.phoneE164 }}" data-track="phone">Call {{ site.contact.phoneDisplay }}</a></li>
        <li><a href="sms:{{ site.contact.phoneE164 }}" data-track="text">Text {{ site.contact.phoneDisplay }}</a></li>
        <li><a href="mailto:{{ site.contact.email }}" data-track="email">{{ site.contact.email }}</a></li>
      </ul>
    </div>
  </div>
</section>
