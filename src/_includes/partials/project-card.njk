<article class="project-card" data-category="{{ project.category }}">
  <div class="compare">
    {%- asyncEach stage in ["before", "after"] %}
    {%- set photo = project[stage] %}
    <figure class="compare-item">
      <button class="photo-button" type="button"
        data-lightbox
        data-full="{% projectPhotoLarge photo.src %}"
        data-alt="{{ photo.alt }}"
        data-caption="{{ stage | capitalize }}: {{ project.title }}"
        aria-label="{{ stage | capitalize }} photo, {{ project.title }}: {{ photo.alt }}. Open larger view.">
        {% projectPhoto photo.src, photo.alt, "(min-width: 1100px) 260px, (min-width: 700px) 45vw, 50vw" %}
      </button>
      <figcaption class="compare-label compare-label-{{ stage }}">{{ stage | capitalize }}</figcaption>
    </figure>
    {%- endeach %}
  </div>
  <div class="project-body">
    <p class="project-meta">
      {{ project.category | categoryLabel(categories) }}{% if project.location %} · {{ project.location }}{% endif %}
    </p>
    <h3>{{ project.title }}</h3>
    {%- if project.description %}
    <p>{{ project.description }}</p>
    {%- endif %}
  </div>
</article>
