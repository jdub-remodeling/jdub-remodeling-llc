<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <script src="/assets/js/early.js"></script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {%- set pageTitle = (title + " | " + site.name) if title else site.name %}
  {%- set canonical = site.url + page.url %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ canonical }}">
  {%- if not site.allowIndexing or noindex %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  {%- if site.siteVerification %}
  <meta name="google-site-verification" content="{{ site.siteVerification }}">
  {%- endif %}
  <meta name="theme-color" content="#1a1a1a">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/og-image.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="J-Dub Remodeling LLC logo">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/oswald-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/styles.css">

  <script type="application/ld+json">{{ structuredData | json | replace("<", "\\u003c") | safe }}</script>
  <script src="/assets/js/main.js" defer></script>
</head>
<body{% if site.analyticsId %} data-ga4-id="{{ site.analyticsId }}"{% endif %}>
  <a class="skip-link" href="#main">Skip to main content</a>

  {% include "partials/header.njk" %}

  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/mobile-bar.njk" %}

  {%- if site.analyticsId %}
  {% include "partials/consent.njk" %}
  {%- endif %}
</body>
</html>
